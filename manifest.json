{
  "manifest_version": 3,
  "name": "Password Manager",
  "version": "0.1.0",
  "description": "Recognizes logins, signups and password resets on any site, saves the credentials and fills them back in.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Password Manager",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "src/shared/domain.js",
        "src/shared/cards.js",
        "src/shared/profiles.js",
        "src/content/fields.js",
        "src/content/forms.js",
        "src/content/outcome.js",
        "src/content/ui.js",
        "src/content/capture.js",
        "src/content/cards.js",
        "src/content/profiles.js",
        "src/content/autofill.js",
        "src/content/debug.js",
        "src/content/main.js"
      ]
    }
  ],
  "commands": {
    "fill-login": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Fill a saved login on this page"
    }
  }
}
